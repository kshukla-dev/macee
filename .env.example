# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OTYS Recruitment API Configuration
# Paste your OTYS Web API Key below:

OTYS_API_KEY=gv0MSr8EV3HovrVzLWcCQ0SkkA8PiortyNWZ2/zrih9IfsTZQ8y33Q==
VITE_OTYS_API_KEY=your_otys_api_key_here

# OTYS Web API Base URL (Default: https://webapi.otys.app/api)
OTYS_API_BASE_URL=https://webapi.otys.app/api
VITE_OTYS_API_BASE_URL=https://webapi.otys.app/api

# OTYS Portal ka Website ID (Default: 2)
OTYS_WEBSITE_ID=1
VITE_OTYS_WEBSITE_ID=1

# Authentication enable karne ke liye
AUTH_API_ENABLED=true
VITE_AUTH_API_ENABLED=true
